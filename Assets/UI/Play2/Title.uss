.title-shell {
    --ink: #14241a;
    --cream: #f5e6c7;
    --red: #df5145;
    --pine: #24392b;
    --pine-highlight: #365741;
    color: var(--cream);
    -unity-font: url("NanumGothic-Regular.ttf");
    font-size: 17px;
    flex-grow: 1;
}
.title-scrim {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 58%;
    background-size: 100% 100%;
}
.title-menu {
    position: absolute;
    left: 5.5%;
    top: 9%;
    width: 29%;
    min-width: 205px;
    max-width: 365px;
    align-items: flex-start;
}
.title-logo {
    width: 100%;
    height: 178px;
    margin-left: -13px;
    margin-bottom: 19px;
    background-image: url("PaintedTitleLogo.png");
    background-size: contain;
    background-position: left center;
}
.menu-button {
    width: 82%;
    min-width: 184px;
    height: 46px;
    margin: 0 0 9px 0;
    padding: 0 17px;
    background-color: transparent;
    background-image: url("TitleCardStock.png");
    background-size: cover;
    -unity-background-image-tint-color: var(--pine);
    color: var(--cream);
    border-width: 1px;
    border-color: var(--cream);
    border-radius: 5px;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    font-size: 19px;
    transition-duration: 0.13s;
}
.menu-button.featured { border-color: var(--red); border-left-width: 3px; }
.menu-button:hover, .menu-button:focus {
    -unity-background-image-tint-color: var(--pine-highlight);
    border-color: #ff806c;
    color: #fff3d9;
}
.menu-button:active { -unity-background-image-tint-color: #496651; }
.menu-button:disabled { opacity: 0.6; }
.menu-button.quiet {
    -unity-background-image-tint-color: rgba(26, 43, 32, 0.82);
    border-color: rgba(245, 230, 199, 0.48);
    height: 38px;
    font-size: 16px;
}
.menu-button.quiet:hover, .menu-button.quiet:focus {
    -unity-background-image-tint-color: var(--pine-highlight);
    border-color: var(--cream);
}
.title-notice { white-space: normal; color: #f5d7b1; font-size: 13px; }
.title-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(7, 17, 10, 0.64);
    align-items: center;
    justify-content: center;
}
.title-dialog {
    width: 470px;
    max-width: 90%;
    padding: 24px 27px;
    background-color: var(--cream);
    background-image: url("TitleCardStock.png");
    background-size: cover;
    -unity-background-image-tint-color: #f8e8cc;
    color: var(--ink);
    border-width: 1px;
    border-color: #baa17d;
    border-radius: 9px;
}
.dialog-heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: #ab9f83;
    padding-bottom: 11px;
    margin-bottom: 15px;
}
.dialog-title { font-size: 27px; -unity-font-style: bold; }
.dialog-mark { color: #a3322c; font-size: 24px; }
.title-dialog .unity-base-field { min-height: 38px; margin: 2px 0 7px 0; align-items: center; }
.title-dialog .unity-base-field__label { color: var(--ink); min-width: 94px; -unity-font-style: bold; }
.title-dialog .unity-text-field__input, .title-dialog .unity-popup-field__input {
    color: var(--ink);
    background-color: #fff8e6;
    border-width: 1px;
    border-color: #aa9f83;
    border-radius: 4px;
    min-height: 33px;
    padding-left: 9px;
}
.title-dialog .unity-text-field__input:focus { border-color: #48604e; }
.title-dialog .unity-base-slider__tracker { height: 7px; border-width: 0; border-radius: 4px; background-color: #b9b093; }
.title-dialog .unity-base-slider__dragger { width: 16px; height: 16px; border-radius: 8px; background-color: #2c4735; border-color: var(--ink); }
.volume-row { flex-direction: row; align-items: center; }
.volume-row .unity-slider { flex-grow: 1; }
.title-dialog .unity-toggle__input { justify-content: flex-end; }
.title-dialog .unity-toggle__checkmark { border-radius: 4px; }
.volume-value { min-width: 48px; -unity-text-align: middle-right; -unity-font-style: bold; }
.dialog-detail { white-space: normal; margin-top: 5px; font-size: 14px; }
.dialog-actions { flex-direction: row; justify-content: flex-end; margin-top: 14px; }
.dialog-button {
    min-height: 39px;
    min-width: 90px;
    margin: 0 0 0 8px;
    color: var(--cream);
    background-color: var(--ink);
    border-width: 1px;
    border-color: var(--ink);
    border-radius: 5px;
    -unity-font-style: bold;
}
.dialog-button:hover, .dialog-button:focus { background-color: #294536; border-color: var(--red); }
.dialog-confirm { background-color: #a3322c; border-color: #a3322c; }
.dialog-confirm:hover, .dialog-confirm:focus { background-color: #842721; }
.title-hidden { display: none; }
